# Get it with: npx ring-auth-cli
RING_REFRESH_TOKEN=

# Logging: info or debug (debug also enables ring-client-api internal logs)
LOG_LEVEL=info
# Log an "I'm alive" line every N minutes (0 = never)
HEARTBEAT_MINUTES=60

# Per-intercom schedule, delay, and cooldown live in devices.json (required).
# Copy devices.json.example → devices.json and set your intercom ids.
